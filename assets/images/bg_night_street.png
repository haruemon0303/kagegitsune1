<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="nightSky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#0a1128;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1c1c3a;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- 夜空 -->
  <rect width="800" height="600" fill="url(#nightSky)"/>

  <!-- 星 -->
  <circle cx="100" cy="80" r="2" fill="#ffffff" opacity="0.8"/>
  <circle cx="250" cy="120" r="1.5" fill="#ffffff" opacity="0.6"/>
  <circle cx="400" cy="60" r="2" fill="#ffffff" opacity="0.9"/>
  <circle cx="600" cy="100" r="1" fill="#ffffff" opacity="0.7"/>
  <circle cx="700" cy="150" r="1.5" fill="#ffffff" opacity="0.8"/>

  <!-- 街の建物（シルエット） -->
  <rect x="0" y="400" width="150" height="200" fill="#0a0a1a" opacity="0.9"/>
  <rect x="180" y="350" width="200" height="250" fill="#0a0a1a" opacity="0.9"/>
  <rect x="420" y="380" width="160" height="220" fill="#0a0a1a" opacity="0.9"/>
  <rect x="620" y="360" width="180" height="240" fill="#0a0a1a" opacity="0.9"/>

  <!-- 窓の明かり -->
  <rect x="20" y="420" width="15" height="20" fill="#ffd480" opacity="0.6"/>
  <rect x="50" y="450" width="15" height="20" fill="#ffd480" opacity="0.4"/>
  <rect x="200" y="380" width="20" height="25" fill="#ffd480" opacity="0.5"/>
  <rect x="240" y="420" width="20" height="25" fill="#ffd480" opacity="0.3"/>
  <rect x="450" y="400" width="15" height="20" fill="#ffd480" opacity="0.6"/>
  <rect x="650" y="390" width="18" height="22" fill="#ffd480" opacity="0.5"/>

  <!-- 街路灯 -->
  <line x1="400" y1="500" x2="400" y2="420" stroke="#3a3a4a" stroke-width="4"/>
  <circle cx="400" cy="415" r="12" fill="#fff8dc" opacity="0.7"/>
  <circle cx="400" cy="415" r="25" fill="#fff8dc" opacity="0.2"/>
</svg>
