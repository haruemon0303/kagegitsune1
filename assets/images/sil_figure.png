<svg xmlns="http://www.w3.org/2000/svg" width="400" height="600" viewBox="0 0 400 600">
  <!-- 謎の人物のシルエット -->
  <g opacity="0.6" fill="#1a2a4a">
    <!-- 頭部 -->
    <ellipse cx="200" cy="150" rx="50" ry="60"/>

    <!-- 帽子/フード -->
    <path d="M 150 140 Q 200 80 250 140 L 240 150 Q 200 110 160 150 Z" fill="#0a1a2a"/>

    <!-- 胴体 -->
    <rect x="160" y="200" width="80" height="150" rx="10"/>

    <!-- マント -->
    <path d="M 140 220 Q 100 300 80 400 L 120 380 Q 140 320 150 280 Z" fill="#0a1a2a" opacity="0.8"/>
    <path d="M 260 220 Q 300 300 320 400 L 280 380 Q 260 320 250 280 Z" fill="#0a1a2a" opacity="0.8"/>

    <!-- 腕 -->
    <ellipse cx="140" cy="270" rx="18" ry="80" transform="rotate(-10 140 270)"/>
    <ellipse cx="260" cy="270" rx="18" ry="80" transform="rotate(10 260 270)"/>

    <!-- 脚 -->
    <rect x="170" y="340" width="25" height="120" rx="5"/>
    <rect x="205" y="340" width="25" height="120" rx="5"/>

    <!-- 不気味な発光 -->
    <circle cx="200" cy="150" r="40" fill="#6a8faf" opacity="0.2"/>
  </g>
</svg>
