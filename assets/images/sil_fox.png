<svg xmlns="http://www.w3.org/2000/svg" width="400" height="600" viewBox="0 0 400 600">
  <!-- 狐のシルエット -->
  <g opacity="0.7" fill="#2a4a6a">
    <!-- 頭部 -->
    <ellipse cx="200" cy="200" rx="60" ry="80"/>

    <!-- 耳（三角形） -->
    <polygon points="160,160 150,120 180,150"/>
    <polygon points="240,160 250,120 220,150"/>

    <!-- 胴体 -->
    <ellipse cx="200" cy="320" rx="50" ry="100"/>

    <!-- 腕 -->
    <ellipse cx="140" cy="320" rx="20" ry="90" transform="rotate(-20 140 320)"/>
    <ellipse cx="260" cy="320" rx="20" ry="90" transform="rotate(20 260 320)"/>

    <!-- 尾（狐らしく大きく） -->
    <path d="M 200 400 Q 250 450 280 520 Q 260 480 240 460 Q 230 500 220 540 Q 210 500 200 480 Z"
          fill="#2a4a6a" opacity="0.8"/>

    <!-- 目の光（神秘的な雰囲気） -->
    <circle cx="185" cy="190" r="5" fill="#6af" opacity="0.9"/>
    <circle cx="215" cy="190" r="5" fill="#6af" opacity="0.9"/>
  </g>
</svg>
